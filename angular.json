{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "tg-studio": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "editor.main.css",
                "input": "node_modules/monaco-editor/min/vs/editor",
                "output": "monaco"
              },
              {
                "glob": "*.svg",
                "input": "node_modules/material-icon-theme/icons",
                "output": "file-icons"
              },
              {
                "glob": "material-icons.json",
                "input": "node_modules/material-icon-theme/dist",
                "output": "file-icons"
              },
              {
                "glob": "LICENSE",
                "input": "node_modules/material-icon-theme",
                "output": "file-icons"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/inter/wght.css",
              "node_modules/@fontsource-variable/jetbrains-mono/wght.css",
              "node_modules/@xterm/xterm/css/xterm.css",
              "src/styles.scss"
            ],
            "allowedCommonJsDependencies": ["@xterm/xterm", "@xterm/addon-fit"],
            "webWorkerTsConfig": "tsconfig.worker.json",
            "loader": {
              ".ttf": "file"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "24kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "tg-studio:build:production"
            },
            "development": {
              "buildTarget": "tg-studio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
